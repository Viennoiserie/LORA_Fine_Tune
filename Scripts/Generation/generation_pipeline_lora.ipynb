 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Image Generation pipeline"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "First, we force the download of the required imports."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === INSTALL DEPENDENCIES === #\n",
    "\n",
    "%pip install -q diffusers==0.30.2 transformers==4.46.3\n",
    "%pip install -q torch torchvision safetensors accelerate hf_transfer numpy pillow python-dotenv ftfy\n",
    "\n",
    "# === IMPORTS === #\n",
    "\n",
    "import os\n",
    "import torch\n",
    "\n",
    "from dotenv import load_dotenv\n",
    "from huggingface_hub import login\n",
    "from diffusers.loaders import AttnProcsLayers\n",
    "from diffusers import StableDiffusionXLPipeline"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Then, in this piece of code we load up, from our hugging face account :\n",
    "\n",
    "- The base SDXL model\n",
    "- The model that was fine tuned with LORA"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === SETUP === #\n",
    "\n",
    "load_dotenv()\n",
    "hf_token = os.getenv(\"HF_TOKEN\")\n",
    "\n",
    "login(token=hf_token)\n",
    "\n",
    "# === LOAD BASE MODEL === #\n",
    "\n",
    "BASE_MODEL = \"Viennoiserie/Pony_V3\"\n",
    "\n",
    "pipe = StableDiffusionXLPipeline.from_pretrained(BASE_MODEL,\n",
    "                                                 torch_dtype=torch.float16,\n",
    "                                                 use_safetensors=True).to(\"cuda\")\n",
    "\n",
    "# === Loading the LORA adapted version === #\n",
    "\n",
    "lora_path = \"Viennoiserie/MODEL\"\n",
    "pipe.load_lora_weights(lora_path)\n",
    "\n",
    "# === (OPTIONAL) Merging the LORA for a better result ===\n",
    "pipe.fuse_lora(lora_scale=0.7) "
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Afterwards, in this piece of code, using the previous model, we generate an image with the prompt we entered."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "prompt = \""\n",
    "negative_prompt = \"blurry, low quality, distorted, extra limbs, unfocused eyes, misaligned pupils, cross-eyed, eyes looking at camera when not intended, unnatural gaze, bad anatomy\"\n",
    "\n",
    "image = pipe(prompt=prompt,\n",
    "             negative_prompt=negative_prompt,\n",
    "\n",
    "             num_inference_steps=30,\n",
    "             height=1024,\n",
    "             width=1024,\n",
    "\n",
    "             guidance_scale=7.5).images[0]\n",
    "\n",
    "image.save(\"Output/test.jpg\")\n",
    "print(\"Image saved !\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Finally, we save it :)\n"
   ]
  }
 ],
